{
  "name": "ximalaya_downloader",
  "version": "1.0.0",
  "description": "Ximalaya Downloader, helps VIP users download their favorite albums",
  "author": "watermelon <844704781@qq.com>",
  "license": "GPL",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --watch --noSandbox -- --disable-gpu",
    "start": "electron-vite dev --watch --noSandbox -- --disable-gpu",
    "postinstall": "node scripts/fix-electron-integrity.cjs",
    "fix:electron-integrity": "node scripts/fix-electron-integrity.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview --noSandbox -- --disable-gpu",
    "dist": "electron-vite build && electron-builder && node scripts/fix-electron-integrity.cjs",
    "cli": "node xmd.js",
    "pkg": "pkg dist/xmd.js --targets node20-win-x64,node20-linux-x64,node20-macos-x64 --public --out-dir dist",
    "build:rollup": "rollup -c",
    "release": "npm i && npm run build:rollup && npm run pkg"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "axios": "^1.7.0",
    "axios-retry": "^4.2.0",
    "commander": "^12.0.0",
    "crypto-js": "^4.2.0",
    "fake-ua": "^1.0.4",
    "log4js": "^6.9.1",
    "mkdirp": "^3.0.1",
    "nedb": "^1.8.0",
    "p-limit": "^5.0.0",
    "random-useragent": "^0.5.0",
    "rimraf": "^5.0.7",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@yao-pkg/pkg": "^5.11.5",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "rollup": "^4.18.0",
    "vite": "^5.4.10",
    "vue": "^3.5.25"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  }
}
